{
  "name": "momi",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8788",
    "build": "vite build",
    "start": "BODY_SIZE_LIMIT=100M bun ./build/index.js",
    "preview": "vite preview --host 0.0.0.0 --port 8788",
    "dev:worker": "vite build && wrangler pages dev build --ip 0.0.0.0 --port 8788",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@types/node": "^26.1.2",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.4.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "exifr": "^7.1.3",
    "maplibre-gl": "^6.3.0",
    "web-push": "^3.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true
  }
}
